# Copy to backend/.env. Generate a random token; never commit real credentials.
HOLYCOW_NOTIFICATIONS_TOKEN=replace-with-at-least-32-random-characters
HOLYCOW_NOTIFICATIONS_DB=backend/state/notifications.sqlite3
HOLYCOW_EVIDENCE_DIRECTORY=backend/evidence
HOLYCOW_MESSAGING_TRANSPORT=simulator
HOLYCOW_FEEDBACK_AGENT=auto

# Telegram is the preferred live transport. Configure using:
# backend/.venv/Scripts/python.exe -m backend.telegram_setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HOLYCOW_LIVE_TELEGRAM_ENABLED=false
TELEGRAM_UPDATES_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# Legacy SMS transport is optional and unused by Telegram.
HOLYCOW_LIVE_SMS_ENABLED=false
HOLYCOW_RECIPIENT_OPTED_IN=false
HOLYCOW_RANCHER_PHONE=
HOLYCOW_PUBLIC_BACKEND_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# With both values configured, auto mode uses the LLM. Otherwise a limited local
# phrase fallback works for common replies; it is not a full language model.
OPENAI_API_KEY=
HOLYCOW_FEEDBACK_MODEL=
